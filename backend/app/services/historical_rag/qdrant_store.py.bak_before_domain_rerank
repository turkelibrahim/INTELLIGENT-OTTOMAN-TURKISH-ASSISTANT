import os
from pathlib import Path
from typing import Any, Dict, List

from fastembed import SparseTextEmbedding
from qdrant_client import QdrantClient, models

from .embedding_provider import OllamaEmbeddingProvider


class HistoricalQdrantStore:

    COLLECTION = "ottoman_historical_knowledge_v1"

    def __init__(
        self,
        path: str | None = None,
    ):
        self.path = Path(
            path
            or os.getenv(
                "HISTORICAL_QDRANT_PATH",
                r"C:\ottoman_ai_data\qdrant"
            )
        )

        self.path.mkdir(
            parents=True,
            exist_ok=True
        )

        self.client = QdrantClient(
            path=str(self.path)
        )

        self.embedding = OllamaEmbeddingProvider()

        self.bm25 = SparseTextEmbedding(
            model_name="Qdrant/bm25",
            language="turkish",
            disable_stemmer=True,
        )

        self._ensure_collection()

    def _ensure_collection(self):

        if self.client.collection_exists(
            self.COLLECTION
        ):
            return

        self.client.create_collection(
            collection_name=self.COLLECTION,

            vectors_config={
                "dense": models.VectorParams(
                    size=1024,
                    distance=models.Distance.COSINE,
                )
            },

            sparse_vectors_config={
                "lexical": models.SparseVectorParams(
                    modifier=models.Modifier.IDF
                )
            },
        )

    def _sparse_vector(
        self,
        text: str,
        query: bool = False
    ):

        if query:
            emb = list(
                self.bm25.query_embed(text)
            )[0]
        else:
            emb = list(
                self.bm25.embed(text)
            )[0]

        return models.SparseVector(
            indices=emb.indices.tolist(),
            values=emb.values.tolist(),
        )

    def upsert(
        self,
        item_id: int,
        text: str,
        payload: Dict[str, Any],
    ):

        dense = self.embedding.embed(text)

        sparse = self._sparse_vector(text)

        point = models.PointStruct(
            id=item_id,

            vector={
                "dense": dense,
                "lexical": sparse,
            },

            payload={
                **payload,
                "text": text,
            },
        )

        self.client.upsert(
            collection_name=self.COLLECTION,
            points=[point],
            wait=True,
        )

    def lexical_search(
        self,
        query: str,
        limit: int = 5,
        verified_only: bool = True,
    ) -> List[Dict[str, Any]]:

        q = self._sparse_vector(
            query,
            query=True,
        )

        query_filter = None

        if verified_only:
            query_filter = models.Filter(
                must=[
                    models.FieldCondition(
                        key="verified",
                        match=models.MatchValue(
                            value=True
                        )
                    )
                ]
            )

        results = self.client.query_points(
            collection_name=self.COLLECTION,
            query=q,
            using="lexical",
            query_filter=query_filter,
            limit=limit,
            with_payload=True,
        ).points

        return [
            {
                "id": hit.id,
                "score": float(hit.score),
                **(hit.payload or {}),
            }
            for hit in results
        ]

    def dense_search(
        self,
        query: str,
        limit: int = 5,
    ) -> List[Dict[str, Any]]:

        q = self.embedding.embed(query)

        results = self.client.query_points(
            collection_name=self.COLLECTION,
            query=q,
            using="dense",
            limit=limit,
            with_payload=True,
        ).points

        return [
            {
                "id": hit.id,
                "score": float(hit.score),
                **(hit.payload or {}),
            }
            for hit in results
        ]

    def count(self) -> int:

        return self.client.count(
            collection_name=self.COLLECTION,
            exact=True,
        ).count

    def delete(self, item_ids: List[int]) -> None:
        if not item_ids:
            return

        self.client.delete(
            collection_name=self.COLLECTION,
            points_selector=models.PointIdsList(
                points=item_ids
            ),
            wait=True,
        )

    def close(self):
        self.client.close()
